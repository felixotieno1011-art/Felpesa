FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY pyproject.toml ./
COPY requirements.lock* ./
# Runtime dependencies only (no pytest etc.), pinned by the lock file when present.
RUN python -c "import tomllib;print('\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > deps.txt \
 && C=""; if [ -f requirements.lock ]; then C="-c requirements.lock"; fi \
 && pip install --upgrade pip && pip install $C -r deps.txt

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts

RUN useradd --system --uid 10001 --no-create-home felpesa && chown -R felpesa /app
USER felpesa
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
