# Test-only environment. Loaded by conftest.py BEFORE app imports.
# Separate DB from felpesa_dev so test cleanup never touches dev data.
POSTGRES_DB=felpesa_test
POSTGRES_USER=felpesa
POSTGRES_PASSWORD=felpesa_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6380/15
APP_ENV=test
JWT_SECRET=test-only-secret-not-for-production-at-least-32-chars
LOG_LEVEL=WARNING
FRAUD_AMOUNT_THRESHOLD=50000
FRAUD_RAPID_WINDOW_SECONDS=60
FRAUD_RAPID_MAX_TRANSFERS=3
RATE_LIMIT_TRANSFERS_PER_MIN=5
