# ---------- Postgres ----------
POSTGRES_USER=felpesa
POSTGRES_PASSWORD=felpesa_dev      # CHANGE IN PROD
POSTGRES_DB=felpesa_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------- Redis ----------
REDIS_URL=redis://localhost:6380/0

# ---------- App ----------
APP_ENV=dev
APP_NAME=Felpesa
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO

# ---------- Auth ----------
# Generate real values: `openssl rand -hex 32`
JWT_SECRET=change-me-please-change-me-please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Rate limiting ----------
RATE_LIMIT_TRANSFERS_PER_MIN=5

# ---------- Fraud ----------
FRAUD_AMOUNT_THRESHOLD=50000
FRAUD_RAPID_WINDOW_SECONDS=60
FRAUD_RAPID_MAX_TRANSFERS=3

# ---------- Auth hardening ----------
RATE_LIMIT_AUTH_PER_MIN=10
REQUIRE_PIN=true

# ---------- Payments ----------
# daraja (sandbox) | mock (tests only, refused when APP_ENV=prod)
PAYMENT_PROVIDER=daraja
# simulated (instant, dev only) | provider (pending, then confirmed or reversed)
WITHDRAWAL_MODE=simulated

# ---------- Daraja sandbox (leave blank to keep M-Pesa switched off) ----------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=
